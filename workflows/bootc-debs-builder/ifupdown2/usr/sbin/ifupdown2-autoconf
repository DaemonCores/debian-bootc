#!/bin/bash
#
# ifupdown2-autoconf - generate /etc/network/interfaces on boot: a DHCP WAN on
# the first ethernet NIC, with a DHCPv6 probe that only adds the inet6 stanza
# when a server answers. Runs only while the marker line at the top is present.
set -euo pipefail

# Write to both stderr (journal) and ttyS0 (serial capture) so diagnostics
# appear in CI serial logs regardless of journald forwarding.
tty_log() { echo "ifupdown2-autoconf: $*" | tee /dev/ttyS0 >&2 || true; }

grep -q "^# ifupdown2-autoconf" /etc/network/interfaces || exit 0

IFACE=$(ip -o link show | awk -F': ' '/ether/{print $2; exit}')
[ -z "$IFACE" ] && exit 0

ip link set "$IFACE" up 2>/dev/null || true

# Probe for a DHCPv4 server before writing the config.  ifupdown2 has no
# built-in fallback: if the interface is configured "inet dhcp" and no server
# answers, ifup blocks and networking.service fails.  We probe first using
# dhclient with a no-op hook script (no lease actions → no interface
# configuration side-effects).  If no server answers within the timeout we
# fall back to "inet manual" (interface up, no IP) which lets
# networking.service succeed and leaves the door open for a later static
# configuration.
# The hook script lives in /usr (installed by this package, always executable,
# never in a potentially-noexec tmpfs).  dhclient forks and calls
# execve(script, ...) for each hook (PREINIT, BOUND, …); a script that is not
# executable causes the child to exit non-zero and dhclient to treat the lease
# as failed.  Having the script in /usr avoids any noexec or permission issues.
HOOK=/usr/sbin/ifupdown2-dhcp4-probe-hook
tty_log "DHCPv4 probe: iface=${IFACE} hook_exists=$(test -e ${HOOK} && echo yes || echo NO) hook_exec=$(test -x ${HOOK} && echo yes || echo NO)"
tty_log "iface link: $(ip link show "${IFACE}" 2>&1 | tr '\n' ' ')"
IPV4_STANZA="iface ${IFACE} inet manual"
if timeout 8 dhclient -4 -1 \
  -sf "${HOOK}" \
  -pf /run/dhcp4-probe.pid \
  -lf /run/dhcp4-probe.leases \
  "$IFACE" >/run/dhcp4-probe.log 2>&1; then
  IPV4_STANZA="iface ${IFACE} inet dhcp"
else
  _rc=$?
  tty_log "DHCPv4 probe exit ${_rc} on ${IFACE} (inet manual):"
  while IFS= read -r _line; do tty_log "  dhclient: ${_line}"; done </run/dhcp4-probe.log || true
fi
# Capture the DHCP-advertised domain from the probe lease before deleting it.
# domain-set runs as ExecStartPost, after ifup has launched dhclient in the
# background; resolv.conf is not yet written at that point.  Reading the domain
# here (synchronously, during ExecStartPre) and saving it to a well-known path
# is the only reliable way to hand it to domain-set.
sed -n 's/.*option domain-name "\([^"]*\)".*/\1/p' \
  /run/dhcp4-probe.leases 2>/dev/null | head -1 >/run/ifupdown2-dhcp-domain || true
rm -f /run/dhcp4-probe.pid /run/dhcp4-probe.leases /run/dhcp4-probe.log

# Probe for a DHCPv6 server before writing the config. The "inet6 auto" stanza
# is added only when a server actually answers; otherwise ifup would spawn a
# dhclient -6 that hangs (30s timeout, networking.service failure) on networks
# whose RA requests DHCPv6 with no server. Kernel SLAAC still provides IPv6
# addressing regardless, so IPv6 keeps working even without the stanza.
IPV6_STANZA=""
if timeout 5 dhclient -6 -1 -q -pf /run/dhcp6-probe.pid \
  -lf /run/dhcp6-probe.leases "$IFACE" >/dev/null 2>&1; then
  IPV6_STANZA="iface ${IFACE} inet6 auto"
fi
dhclient -6 -x -pf /run/dhcp6-probe.pid "$IFACE" >/dev/null 2>&1 || true
rm -f /run/dhcp6-probe.pid /run/dhcp6-probe.leases

cat >/etc/network/interfaces <<EOF
# ifupdown2-autoconf: auto-configured on boot, remove this line to disable
source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

auto ${IFACE}
${IPV4_STANZA}
${IPV6_STANZA}
EOF
