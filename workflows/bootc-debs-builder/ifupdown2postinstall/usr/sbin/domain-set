#!/bin/bash
#
# domain-set - render /etc/hosts and /etc/issue from their templates using the
# host's current global IPv4 address, short hostname and DHCP-advertised domain.
set -euo pipefail

IP=$(ip -4 addr show scope global \
  | grep -oP "(?<=inet )[\d.]+" | head -1 || true)

if [[ -z "$IP" ]]; then
  exit 0
fi

HOST=$(hostname -s)
# First domain advertised over DHCP.  ifupdown2-autoconf (ExecStartPre) reads
# the domain from the dhclient probe lease synchronously and saves it here;
# we read it now rather than from /etc/resolv.conf, which is written by dhclient
# running in the background and is not yet populated when ExecStartPost fires.
FQDN=$(tr -d '[:space:]' 2>/dev/null </run/ifupdown2-dhcp-domain || echo "")
[[ "${FQDN}" == "" ]] \
  && FQDN="local"

# Reject FQDN values that could break the sed substitution (| & \ characters).
[[ "${FQDN}" =~ ^[A-Za-z0-9.-]{1,253}$ ]] || FQDN="local"

#######################################
# Render /etc/hosts from its template.
# Globals:
#   IP
#   HOST
#   FQDN
# Outputs:
#   Writes /etc/hosts.
#######################################
setdomaine() {
  cp /etc/hosts.tpl /etc/hosts
  sed -i \
    -e "s|{{ IP }}|${IP}|g" \
    -e "s|{{ HOST }}|${HOST}|g" \
    -e "s|{{ FQDN }}|${FQDN}|g" \
    /etc/hosts
}

setdomaine || true

cp /etc/issue.tpl /etc/issue
sed -i "s|{{ IP }}|${IP}|g" /etc/issue
