+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+from gi.repository import Adw, Gtk
+
+from bootc_installer.utils.system_config import valid_hostname, valid_root_password
+
+
+@Gtk.Template(resource_path="/org/bootcinstaller/Installer/gtk/default-system.ui")
+class BootcDefaultSystem(Adw.Bin):
+    __gtype_name__ = "BootcDefaultSystem"
+
+    btn_next = Gtk.Template.Child()
+    hostname_entry = Gtk.Template.Child()
+    root_password_entry = Gtk.Template.Child()
+    root_password_confirmation = Gtk.Template.Child()
+    sudo_switch = Gtk.Template.Child()
+    ssh_root_switch = Gtk.Template.Child()
+
+    def __init__(self, window, distro_info, key, step, **kwargs):
+        super().__init__(**kwargs)
+        self.__window = window
+        self.__distro_info = distro_info
+        self.__key = key
+        self.__step = step
+        self.delta = False
+
+        for row in (self.hostname_entry, self.root_password_entry,
+                    self.root_password_confirmation):
+            row.connect("changed", self.__on_field_changed)
+        self.btn_next.connect("clicked", self.__window.next)
+        self.__on_field_changed()
+
+    def should_show(self, context: dict) -> bool:
+        return True
+
+    def test_auto_advance(self):
+        self.btn_next.emit("clicked")
+
+    def __hostname_ok(self) -> bool:
+        # Empty keeps the hardware-derived hostname chosen by the installer.
+        text = self.hostname_entry.get_text().strip()
+        return not text or valid_hostname(text)
+
+    def __on_field_changed(self, *args):
+        hostname_ok = self.__hostname_ok()
+        passwords_ok = valid_root_password(
+            self.root_password_entry.get_text(),
+            self.root_password_confirmation.get_text(),
+        )
+        for widget, ok in ((self.hostname_entry, hostname_ok),
+                           (self.root_password_confirmation, passwords_ok)):
+            if ok:
+                widget.remove_css_class("error")
+            else:
+                widget.add_css_class("error")
+        self.btn_next.set_sensitive(hostname_ok and passwords_ok)
+
+    def get_finals(self):
+        finals = {
+            "system": {
+                "rootPassword": self.root_password_entry.get_text(),
+                "sudo": self.sudo_switch.get_active(),
+                "sshRootLogin": self.ssh_root_switch.get_active(),
+            }
+        }
+        hostname = self.hostname_entry.get_text().strip()
+        if hostname:
+            finals["hostname"] = hostname
+        return finals
diff --git a/bootc_installer/gtk/default-system.blp b/bootc_installer/gtk/default-system.blp
new file mode 100644
--- /dev/null
+++ b/bootc_installer/gtk/default-system.blp
@@ -0,0 +1,91 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $BootcDefaultSystem: Adw.Bin {
+  halign: fill;
+  valign: fill;
+  hexpand: true;
+
+  Overlay {
+    vexpand: true;
+    hexpand: true;
+
+    [overlay]
+    Button btn_next {
+      margin-end: 12;
+      margin-start: 12;
+      icon-name: "go-next-symbolic";
+      halign: end;
+      valign: center;
+      tooltip-text: _("Next");
+      sensitive: false;
+
+      styles [
+        "suggested-action",
+      ]
+    }
+
+    ScrolledWindow {
+      hscrollbar-policy: never;
+      vexpand: true;
+      hexpand: true;
+
+      Adw.PreferencesPage {
+        Adw.PreferencesGroup {
+          $BootcPageHeader page_header {
+            margin-top: 24;
+            icon-name: "preferences-system-symbolic";
+            title: _("System");
+            subtitle: _("Name this computer and secure the administrator account.");
+          }
+        }
+
+        Adw.PreferencesGroup {
+          Adw.EntryRow hostname_entry {
+            title: _("Hostname (empty keeps the generated one)");
+          }
+        }
+
+        Adw.PreferencesGroup {
+          Adw.PasswordEntryRow root_password_entry {
+            title: _("Root password (8 characters minimum)");
+            input-purpose: password;
+          }
+
+          Adw.PasswordEntryRow root_password_confirmation {
+            title: _("Confirm root password");
+            input-purpose: password;
+          }
+        }
+
+        Adw.PreferencesGroup {
+          Adw.ActionRow {
+            title: _("Administrator rights for your user");
+            subtitle: _("Allows running commands as root with sudo.");
+
+            [suffix]
+            Switch sudo_switch {
+              valign: center;
+              active: true;
+            }
+
+            activatable-widget: sudo_switch;
+          }
+
+          Adw.ActionRow {
+            title: _("Allow root login over SSH with a password");
+            subtitle: _("Not recommended for a machine reachable from a network.");
+
+            [suffix]
+            Switch ssh_root_switch {
+              valign: center;
+              active: false;
+            }
+
+            activatable-widget: ssh_root_switch;
+          }
+        }
+      }
+    }
+  }
+}
