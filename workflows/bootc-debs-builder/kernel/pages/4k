# kernel/pages/4k
#
# arm64 page-size overlay for the 4 KB kernel. Merged on top of kernel/config by
# the linux-image entry when it builds for arm64. The 4 KB granule is the one
# every arm64 core implements, so this kernel boots the older devices that lack
# the 16 KB granule: Raspberry Pi 3 (Cortex-A53, TGran16 = not supported per the
# Cortex-A53 TRM, DDI 0500J) and Raspberry Pi 4 (Cortex-A72). See
# docs/decisions.md ("Two arm64 kernels").
#
# The page size is a compile-time choice (ARM64_4K_PAGES / ARM64_16K_PAGES /
# ARM64_64K_PAGES are a Kconfig choice), so it cannot be a module: a second
# kernel is the only way to serve both generations.

CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set
