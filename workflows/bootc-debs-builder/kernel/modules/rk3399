# kernel/modules/rk3399
#
# Per-generation MODULE overlay for the Rockchip RK3399 (2x Cortex-A72 +
# 4x Cortex-A53). Applied on top of the base kernel/config THEN the ARM-generic
# overlay kernel/modules/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/arm kernel/modules/rk3399
#     make olddefconfig
#
# Built AGAINST the 4 KB kernel, like the Pi 3/4 modules: RK3399 is the
# pre-RK3588 generation and has no arm64 16 KB page size heritage in our set.
#
# RK3399 was NOT already covered: the RK3588 overlay enables only
# sdhci-of-arasan-agnostic SDHCI cores (kernel/modules/arm) and the Rockchip
# platform core (CONFIG_ARCH_ROCKCHIP — a one-liner also restated here, built
# once in the kernel) but NOT the RK3399's DesignWare dw-mshc SD/eMMC
# controller, and the DWMAC/STMMAC Ethernet pair lives in the rk3588
# device overlay, not in the ARM-generic one. A board booting this SoC with
# only the base kernel has no rootfs storage: it needs this fragment.
# Boards: NanoPC-T4, RockPro64, Rock Pi 4, Pinebook Pro, Firefly rk3399.
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. Restated so the fragment is
# self-describing (merge last-wins no-op against the kernel build).
# =============================================================================

CONFIG_ARCH_ROCKCHIP=y

# =============================================================================
# MMC / SD / eMMC — built-in. RK3399 boards boot from SD or eMMC on the
# DesignWare dw-mshc controller (CONFIG_MMC_DW + CONFIG_MMC_DW_ROCKCHIP),
# which neither kernel/modules/arm (SDHCI family) nor the rk3588 overlay
# cover. Bootc rootfs must be readable without a module load step.
# =============================================================================

CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# =============================================================================
# Ethernet — the RK3399 GMAC is dwmac-rknic on top of the generic DWMAC
# platform driver. Same PHYLINK/modpost pattern as the rk3588 overlay
# (all three =m on purpose).
# =============================================================================

CONFIG_DWMAC_GENERIC=m
CONFIG_STMMAC_ETH=m
CONFIG_PHYLINK=m

# =============================================================================
# I2C — built-in. The rk808 PMIC (with its own RTC cell) sits on the rk3x
# I2C controller on every RK3399 board.
# =============================================================================

CONFIG_I2C_RK3X=y

# =============================================================================
# RTC — the board RTC is either the RK808 PMIC's cell or an external HYM8563;
# both drivers shipped so either board layout gets its clock (CONFIG_RTC_CLASS
# is in kernel/modules/arm).
# =============================================================================

CONFIG_RTC_DRV_HYM8563=y
CONFIG_RTC_DRV_RK808=y