# kernel/modules/h616
#
# Per-family MODULE overlay for the Allwinner sun50i family — H616 and its
# smaller twin H613 (4x Cortex-A53), and by the same family core the H6/H5/A64
# boards that reuse these drivers. Applied on top of the base kernel/config
# THEN the ARM-generic overlay kernel/modules/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/arm kernel/modules/h616
#     make olddefconfig
#
# Built AGAINST the 4 KB kernel: sunxi arm64 has no proven 16 KB page size
# story (upstream defconfig and distro images are 4 KB) — keep it there until
# a 16 KB kernel boots on an H616.
# Boards: Orange Pi Zero 2 / Zero 3 / Zero 3B (H613/H618 variants), Orange Pi
# 3 LTS (H6/H616), T-Head 1531 devices, etc. A64 boards (Pine A64, Pinephone)
# share the same sunxi family drivers; they are served by the same fragment.
#
# This file lists ONLY options specific to the sunxi family. It does NOT cover
# the RK/DWC glue of other SoCs; those live in their own family overlays.
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. The sun50i platform core (+ its clock
# drivers, sunxi-ccu, selected by ARCH_SUNXI on the arm64 defconfig) before
# the device tree can even be parsed.
# =============================================================================

CONFIG_ARCH_SUNXI=y

# =============================================================================
# MMC / SD / eMMC — built-in. H616 boards boot from SD only (all models);
# the controller is the Allwinner MMC driver, NOT an SDHCI variant, so
# kernel/modules/arm does not cover it. Bootc rootfs must be readable
# without a module load step.
# =============================================================================

CONFIG_MMC_SUNXI=y

# =============================================================================
# USB — the H616's host controller is EHCI/OHCI with the Allwinner platform
# wrappers, not a DWC3 (the DWC3 built-in of kernel/modules/arm is for the
# other SoCs and stays dormant here). The wrappers must be present for the
# root hub to appear.
# =============================================================================

CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# =============================================================================
# Ethernet — the H616 has ONE GMAC driven by DesignWare's DWMAC with the
# sun8i emac glue (emac1). Same PHYLINK/modpost pattern as the rockchip
# overlays (all three =m on purpose).
# =============================================================================

CONFIG_DWMAC_SUN8I=m
CONFIG_STMMAC_ETH=m
CONFIG_PHYLINK=m

# =============================================================================
# I2C — built-in. The marvell/mv64xxx I2C controller is the H616's I2C IP;
# the AXP313A PMIC (power sequencing + regulators) sits on it.
# =============================================================================

CONFIG_I2C_MV64XXX=y

# =============================================================================
# RTC — built-in. The H616's internal RTC (sun6i core, shared with H6/A64);
# without it systemd-timesyncd has no fallback time and bootc rollback
# ordering can break. (CONFIG_RTC_CLASS is in kernel/modules/arm.)
# =============================================================================

CONFIG_RTC_DRV_SUN6I=y

# =============================================================================
# Power / charger — module. The AXP PMICs (AXP20x core, AXP313A cell) carry
# regulator state for USB/PCIe power gates; useful userspace, not boot path.
# =============================================================================

CONFIG_MFD_AXP20X=m
CONFIG_MFD_AXP20X_I2C=m