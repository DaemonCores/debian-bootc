# kernel/modules/imx8m
#
# Per-family MODULE overlay for the NXP i.MX8M family — i.MX8MQ, 8MM, 8MP
# (Cortex-A53 + M4 / M7). Applied on top of the base kernel/config THEN the
# ARM-generic overlay kernel/modules/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/arm kernel/modules/imx8m
#     make olddefconfig
#
# Built AGAINST the 4 KB kernel like the Pi 3/4 modules — the i.MX8M boards
# of our set (the DevTerm/DevKit class, MNT Reform, the Olimex class) have no
# 16 KB page size heritage in our arm64 set.
# Boards: Boundary Devices Nitrogen8M(i), Toradex Verdin iMX8M Mini, MNT
# Reform, SolidRun Cubox-M/CB-M, etc.
#
# This file lists ONLY options specific to the i.MX8M family (Freescale FEC
# Ethernet, the esdhc SD/MMC glue, the SNVS RTC), not the shared cores
# (SDHCI, USB DWC3, RTC class) that kernel/modules/arm carries.
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. ARCH_MXC brings the imx8m clock drivers
# (CONFIG_CLK_IMX8MQ / 8MM / 8MP are the SoC clocks of the family, selected
# with the arch core) and the GPC/IPMU interrupt glue; the device tree needs
# it before any SoC device probe.
# =============================================================================

CONFIG_ARCH_MXC=y

# =============================================================================
# MMC / SD / eMMC — built-in. i.MX8M boards boot from SD or eMMC on the
# ESDHC controller (CONFIG_MMC_SDHCI + CONFIG_MMC_SDHCI_PLTFM cores are in
# kernel/modules/arm; this adds ONLY the iMX variant glue). Bootc rootfs
# must be readable without a module load step.
# =============================================================================

CONFIG_MMC_SDHCI_ESDHC_IMX=y

# =============================================================================
# Ethernet — module. The FEC (Fast Ethernet Controller) drives the i.MX8M
# boards' GMAC; not needed early (bootc pulls updates from userspace), and
# the =m keeps phylink.ko in the build for the other Ethernet drivers
# (same PHYLINK/modpost pattern as the rockchip overlays).
# =============================================================================

CONFIG_FEC=m

# =============================================================================
# I2C — built-in. The imx7d I2C controller hosts the PMIC (BD718x, PCA9450)
# of the i.MX8M boards; needed early for board power sequencing.
# =============================================================================

CONFIG_I2C_IMX=y

# =============================================================================
# RTC — built-in. The i.MX8M's SNVS RTC (secure nonvolatile storage block);
# without it systemd-timesyncd has no fallback time and bootc rollback
# ordering can break. (CONFIG_RTC_CLASS is in kernel/modules/arm.)
# =============================================================================

CONFIG_RTC_DRV_SNVS=y

# =============================================================================
# Watchdog — module. The IMX2 watchdog is reboot-safe on the 8M; module (its
# absence does not break boot, it is a maintenance tool).
# =============================================================================

CONFIG_IMX2_WDT=m
CONFIG_IMX_SC_WDT=m