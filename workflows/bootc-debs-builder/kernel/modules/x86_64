# kernel/modules/x86_64
#
# Per-device MODULE overlay for x86_64. Applied on top of the base
# kernel/config:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/x86_64
#     make olddefconfig
#
# This file is NOT a full .config. It lists ONLY options that are specific
# to the x86_64 device class — everything shared across all devices
# (filesystems, virtio, serial console, the shared hardware support) lives in
# kernel/config and is NOT repeated here. The modules built from this overlay
# are OPTIONAL; the base image (linux-image-common) works without them.
#
# Device: x86_64 PC / server / VM (amd64). No SoC platform option is needed
# (the x86 defconfig already enables the PC platform).
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# Block / storage — built-in so the initramfs can find the rootfs without
# needing to load a module. bootc/ostree rootfs may be on NVMe or SATA on
# bare-metal x86_64 deployments.
# =============================================================================

# NVMe SSDs: built-in so a bootc install on an NVMe drive can boot without
# an initramfs module load step.
CONFIG_BLK_DEV_NVME=y

# SATA AHCI: built-in for bare-metal deployments on classic SATA SSDs/HDDs.
CONFIG_SATA_AHCI=y

# =============================================================================
# Network — modules, so they are only loaded when the corresponding hardware
# is present. Avoids pinning driver memory on hardware that does not need it.
# Hotplug handles module loading at runtime. virtio-net (for VMs) is built-in
# in config-common; here are the physical NIC drivers.
# =============================================================================

# e1000: Intel 82540/82545/82546 — common in older Intel NICs and in qemu
#        when virtio-net is not available. Module to save RAM on non-Intel.
CONFIG_E1000=m

# e1000e: Intel PCIe Gigabit NIC (82571..82583, I218). Module for the same
#         reason as e1000.
CONFIG_E1000E=m

# igb: Intel I210/I350 Gigabit. Common on server bare metal. Module.
CONFIG_IGB=m

# r8169: Realtek 8168/8169/8111 — the most common consumer onboard NIC.
#        Module.
CONFIG_R8169=m

# =============================================================================
# USB host controllers — modules. Needed if a USB keyboard has to be
# attached for emergency console access. Module so they are not loaded on
# hardware without USB.
# =============================================================================

# USB XHCI: USB 3.0 host controller. Module — loaded only when USB is
#           plugged in (hotplug).
CONFIG_USB_XHCI_HCD=m

# USB EHCI: USB 2.0 host controller. Same rationale.
CONFIG_USB_EHCI_HCD=m

# =============================================================================
# Graphics — physical GPU drivers as modules. The base config enables DRM as a
# module; these load only when matching hardware is present, so a machine
# without the
# device pays nothing for them.
# =============================================================================

# Intel integrated and discrete GPUs (i915 for legacy and Xe-era, xe for newer).
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m

# AMD Radeon / Ryzen integrated GPUs, including the older Southern/Sea Islands
# parts and the display core.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y

# Legacy AMD/ATI Radeon.
CONFIG_DRM_RADEON=m

# NVIDIA GPUs through the in-tree nouveau driver.
CONFIG_DRM_NOUVEAU=m

# Older and server adapters.
CONFIG_DRM_GMA500=m
CONFIG_DRM_MGAG200=m
CONFIG_DRM_AST=m
CONFIG_DRM_UDL=m
CONFIG_DRM_VBOXVIDEO=m

# =============================================================================
# Disable debug/testing modules that reference x86-specific kernel symbols
# (e.g. __x86_return_thunk, hwpoison_filter_register) only resolvable from
# vmlinux.o — which is absent in a modules-only build. These modules are pure
# debug facilities with no use in a production bootc image.
# =============================================================================

# HWPOISON_INJECT: disable memory poison injection test module. References
# __x86_return_thunk and hwpoison_filter_register which require vmlinux.o to
# resolve at modpost time; without it the modules build fails with unresolved
# symbol errors.
# CONFIG_HWPOISON_INJECT is not set

# =============================================================================
# Disable module signing — signing requires certs/signing_key.pem, which is
# generated only during a full kernel build (make bindeb-pkg). In a
# modules-only build that file is absent, so modules_install aborts with an
# SSL error. The bootc image does not enforce module signature verification, so
# there is no security regression in disabling auto-signing here.
# =============================================================================

# CONFIG_MODULE_SIG_ALL is not set