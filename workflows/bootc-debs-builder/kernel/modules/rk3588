# kernel/modules/rk3588
#
# Per-device MODULE overlay for the Rockchip RK3588. Applied on top of the
# base kernel/config THEN the ARM-generic overlay kernel/modules/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/arm kernel/modules/rk3588
#     make olddefconfig
#
# This file is NOT a full .config. It lists ONLY options that are specific
# to the RK3588 — everything shared across all devices (filesystems, virtio,
# serial console, the shared hardware support) lives in kernel/config, and
# everything shared across all ARM devices (ARM64, CMDLINE, PL011, MMC/USB/RTC
# subsystem cores) lives in kernel/modules/arm. Neither is repeated here. The
# modules built from this overlay are OPTIONAL; the base image
# (linux-image-common) works without them.
#
# Device: Rockchip RK3588 (4x Cortex-A76 + 4x Cortex-A55). Boards: Orange
# Pi 5, Radxa Rock 5, Pine64 QuartzModel-A, NanoPi R6S, etc.
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. The kernel must know about the SoC before
# it can parse the device tree, so this is built-in rather than a module.
# =============================================================================

# Rockchip: RK3588 platform support. Built-in.
CONFIG_ARCH_ROCKCHIP=y

# =============================================================================
# MMC / SD / eMMC — built-in. Most RK3588 boards boot from SD or eMMC; the
# bootc rootfs will live on this storage, so the kernel must be able to read
# it without a module load step. The SDHCI core + platform glue + USB host
# controllers + RTC subsystem core are shared across all ARM devices and live
# in kernel/modules/arm; this overlay keeps ONLY the RK3588-specific SDHCI
# platform variant (none — the base SDHCI + sdhci-of-arasan is covered by
# MMC_SDHCI_PLTFM in kernel/modules/arm).
# =============================================================================

# (No device-specific MMC option here: the RK3588 sdhci-of-arasan controller
#  is covered by CONFIG_MMC_SDHCI + CONFIG_MMC_SDHCI_PLTFM in kernel/modules/arm.)

# =============================================================================
# Ethernet — built-in. Network must come up at boot so bootc can fetch the
# next deployment.
# =============================================================================

# DWMAC_GENERIC: module. Generic DWMAC platform driver, used by the RK3588
#                for its GMAC. Kept as =m: STMMAC_ETH selects PHYLINK, so
#                forcing it built-in promotes PHYLINK to =y which removes
#                phylink.ko from the build and breaks macb.ko / pcs-lynx.ko
#                at modpost (phylink_* undefined). Network is not needed in
#                early boot (bootc pulls updates from userspace).
CONFIG_DWMAC_GENERIC=m

# STMMAC_ETH: module. Core driver required by DWMAC_GENERIC above.
#             Kept as =m for the same PHYLINK/modpost reason.
CONFIG_STMMAC_ETH=m
# Pin PHYLINK to =m so STMMAC_ETH's select cannot promote it to =y.
CONFIG_PHYLINK=m

# =============================================================================
# USB — built-in. USB is used on several RK3588 boards as the only way to
# attach a keyboard for emergency console access, and as a storage path. The
# DWC3 + XHCI + EHCI host controllers are shared across all ARM devices and
# live in kernel/modules/arm.
# =============================================================================

# (No device-specific USB option here: CONFIG_USB_DWC3 + CONFIG_USB_XHCI_HCD
#  + CONFIG_USB_EHCI_HCD are in kernel/modules/arm.)

# =============================================================================
# RTC — built-in. The RK3588 has an internal RTC. Without the driver,
# systemd-timesyncd has no fallback time and bootc rollback ordering can
# break (two deployments with the "same" timestamp). The RTC subsystem core
# (CONFIG_RTC_CLASS) is shared across all ARM devices and lives in
# kernel/modules/arm; this overlay keeps ONLY the RK3588-specific RTC driver.
# =============================================================================

# RTC_DRV_PL031: built-in. ARM PrimeCell RTC, used by the RK3588.
#                (CONFIG_RTC_CLASS is in kernel/modules/arm.)
CONFIG_RTC_DRV_PL031=y
# =============================================================================
# NPU — module. The RK3588 has three NPU cores (rockchip,rk3588-rknn-core in
# rk3588-base.dtsi) driven by the mainline Rocket driver, the compute path for
# neural-network inference. It needs CONFIG_DRM_ACCEL (kernel/config) and
# CONFIG_ROCKCHIP_IOMMU (set by the arm64 defconfig).
# =============================================================================

CONFIG_DRM_ACCEL_ROCKET=m
