# kernel/modules/rpi5
#
# Per-device MODULE overlay for the Raspberry Pi 5 (BCM2712). Applied on top
# of the base kernel/config THEN the ARM-generic overlay kernel/modules/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/arm kernel/modules/rpi5
#     make olddefconfig
#
# This file is NOT a full .config. It lists ONLY options that are specific
# to the Raspberry Pi 5 — everything shared across all devices (filesystems,
# virtio, serial console, the shared hardware support) lives in kernel/config, and
# everything shared across all ARM devices (ARM64, CMDLINE, PL011, MMC/USB/RTC
# subsystem cores) lives in kernel/modules/arm. Neither is repeated here. The
# modules built from this overlay are OPTIONAL; the base image
# (linux-image-common) works without them.
#
# Device: Raspberry Pi 5 (Broadcom BCM2712, ARM Cortex-A76).
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. The kernel must know about the SoC before
# it can parse the device tree, so this is built-in rather than a module.
# =============================================================================

# BCM2712: Raspberry Pi 5 SoC, selected by ARCH_BCM2835 (family symbol). Built-in.
CONFIG_ARCH_BCM2835=y

# =============================================================================
# MMC / SD / eMMC — built-in. The Pi boots from the SD card; the kernel must
# be able to read it without a module load step. The SDHCI core + platform
# glue + USB host controllers are shared across all ARM devices and live in
# kernel/modules/arm; this overlay keeps ONLY the Broadcom-specific SDHCI
# controller (sdhost).
# =============================================================================

# Broadcom SDHCI: built-in. Raspberry Pi 5 uses a custom SDHCI controller
#                 (sdhost) for the SD card. Required to boot from the SD card.
#                 (CONFIG_MMC_SDHCI + CONFIG_MMC_SDHCI_PLTFM are in
#                 kernel/modules/arm.)
CONFIG_MMC_BCM2835=y

# =============================================================================
# Ethernet and RP1 I/O chip — modules. Network must come up at boot so bootc can
# fetch the next deployment; the initramfs loads these modules.
# =============================================================================

# The Pi 5 wired Ethernet, USB, I2C, SPI and UART sit behind the RP1 I/O chip,
# which hangs off a PCIe link. Mainline 7.x ships the RP1 drivers
# (drivers/misc/rp1, drivers/pinctrl, drivers/clk); the Debian 6.12 kernel does
# not. The Ethernet MAC inside RP1 is a Cadence GEM, driven by MACB, not by
# GENET (GENET is the Pi 4 controller, see kernel/modules/rpi4).
# =============================================================================

# PCIE_BRCMSTB: module. BCM2712 PCIe root complex that carries the RP1 chip.
CONFIG_PCIE_BRCMSTB=m

# MISC_RP1: module. Core driver of the RP1 peripheral chip.
CONFIG_MISC_RP1=m

# PINCTRL_RP1 and COMMON_CLK_RP1: modules. GPIO/pinmux and clocks of RP1.
CONFIG_PINCTRL_RP1=m
CONFIG_COMMON_CLK_RP1=m

# MACB: module. Cadence GEM Ethernet controller inside RP1 (Pi 5 RJ45 port).
CONFIG_MACB=m
