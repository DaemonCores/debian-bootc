# kernel/modules/mt8183
#
# Per-family MODULE overlay for the MediaTek Kompanio/MT8167-MT8183 family
# (8x Cortex-A53; MT8167 is the smaller sibling the Chromebook boards share
# the driver set with). Applied on top of the base kernel/config THEN the
# ARM-generic overlay kernel/modules/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config kernel/modules/arm kernel/modules/mt8183
#     make olddefconfig
#
# Built AGAINST the 4 KB kernel: our arm64 set has no proven MediaTek 16 KB
# page size story; keep the devices on the 4 KB kernel until one boots.
# Boards: the MT8183 Chromebooks (kukui/jacuzzi class: ASUS Chromebook Detach,
# Lenovo IdeaPad Duet, HP Chromebook 11a), the MT8167 tablets, and the Bananas
# Pi BPi-F3-class boards downstream of the same SoC core.
#
# This file lists ONLY options specific to the MediaTek family; the shared
# cores (SDHCI, USB DWC3/XHCI/EHCI, RTC class) are in kernel/modules/arm.
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. ARCH_MEDIATEK brings the mt8183 clock
# driver (mt8183-cam-ccu family, and the topckgen/apmixed cores) and the
# mediatek INFRACFG/AO interrupt glue before the device tree can be parsed.
# =============================================================================

CONFIG_ARCH_MEDIATEK=y

# =============================================================================
# MMC / SD / eMMC — built-in. The MT8183/8167 boards boot from eMMC or SD on
# the MTK MSDC controller (NOT an SDHCI variant, so kernel/modules/arm does
# not cover it). Bootc rootfs must be readable without a module load step.
# =============================================================================

CONFIG_MMC_MTK=y

# =============================================================================
# Ethernet — module. The MTK GMAC is dwmac-mediatek on top of the generic
# STMMAC core (the Chromebooks use WiFi, but the SBC boards wire the GMAC);
# same PHYLINK/modpost pattern as the rockchip overlays (all three =m).
# =============================================================================

CONFIG_DWMAC_MEDIATEK=m
CONFIG_STMMAC_ETH=m
CONFIG_PHYLINK=m

# =============================================================================
# I2C — built-in. The MT65xx I2C controller hosts the MT6358 PMIC (power
# sequencing, regulators) of the MT8183 boards; needed early at boot.
# =============================================================================

CONFIG_I2C_MT65XX=y

# =============================================================================
# RTC — module. The MT6397 PMIC's RTC cell (the board's only RTC); the core
# and the i2c cell are =m, and systemd loads them at boot via the device
# tree modalias before timesyncd runs.
# =============================================================================

CONFIG_MFD_MT6397=m
CONFIG_RTC_DRV_MT6397=m

# =============================================================================
# Serial — built-in restated? No: the 8250 + MTK serial glue of the arm64
# defconfig covers the debug UART; the CMDLINE console (ttyS0) of
# kernel/modules/arm reaches it directly, nothing to add here.
# =============================================================================