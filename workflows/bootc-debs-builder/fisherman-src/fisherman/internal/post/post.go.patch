+// autoUpdateTimer is the unit the bootc package enables to fetch and apply
+// image updates.
+const autoUpdateTimer = "bootc-fetch-apply-updates.timer"
+
+// DisableAutoUpdate switches the automatic image updates off on the installed
+// system at target by masking the bootc update timer: it links
+// /etc/systemd/system/bootc-fetch-apply-updates.timer to /dev/null in the
+// deployment /etc, which overrides the unit the image enables.
+func DisableAutoUpdate(target string) error {
+	etcDir, err := deployEtcDir(target)
+	if err != nil {
+		return err
+	}
+	unitDir := filepath.Join(etcDir, "systemd", "system")
+	if err := runner.Run("mkdir", "-p", unitDir); err != nil {
+		return fmt.Errorf("mkdir %s: %w", unitDir, err)
+	}
+	link := filepath.Join(unitDir, autoUpdateTimer)
+	if err := runner.Run("ln", "-sfn", "/dev/null", link); err != nil {
+		return fmt.Errorf("link %s: %w", link, err)
+	}
+	fmt.Fprintf(os.Stdout, "  masked %s (%s -> /dev/null)\n", autoUpdateTimer, link)
+	return nil
+}
