+// resolveBootloader maps the recipe's bootloader to the value bootc receives.
+// "auto" means the bootloader is detected at installation (Debian-bootc dual
+// bootloader images): a machine the installer runs on when it booted through
+// UEFI installs GRUB through bootupd exactly like a grub2 recipe; anything
+// else — U-Boot boards, whose firmware is not UEFI — passes --bootloader none
+// so bootc writes no bootloader and the board's U-Boot firmware serves /boot.
+func resolveBootloader(b string) string {
+	if b != "auto" {
+		return b
+	}
+	if efiFirmwarePresent() {
+		progress.Info("Detected UEFI firmware: bootc installs GRUB (bootupd)")
+		return "grub2"
+	}
+	progress.Info("Detected U-Boot firmware: bootc skips the bootloader stage")
+	return "none"
+}
+
+// efiFirmwarePresent reports whether the machine fisherman is installing on
+// was booted through UEFI: /sys/firmware/efi only exists when the firmware
+// has exposed the EFI system table (Linux leaves it absent on legacy BIOS and
+// on U-Boot boots).
+func efiFirmwarePresent() bool {
+	st, err := os.Stat("/sys/firmware/efi")
+	return err == nil && st.IsDir()
+}
