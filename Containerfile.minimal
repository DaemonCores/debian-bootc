#####################################################################################
# Containerfile.minimal — multi-arch (x86_64 + ARM64)
#
# Ultra-minimal bootc/ostree image for x86_64 (AMD7) and ARM64 (AArch64).
# Research target (lead-research): ~50 MB RAM idle realistic with aggressive
# masking; the < 10 MB stretch goal is unreachable without dropping systemd.
#
# Multi-arch strategy (BuildKit):
#   - Built on Containerfile.base (debian:trixie); the image is built NATIVELY on the target-arch
#     runner (no QEMU cross-build), so apt pulls arch-matching .deb packages.
#   - ARG ARCH (default amd64; CI overrides to arm64 via --build-arg ARCH=arm64)
#     selects the kernel and firmware packages via the linux-image-${ARCH}
#     naming pattern. BOOT_PKG is a separate ARG because the arm64 embedded
#     profile uses u-boot-tools instead of grub-efi-arm64 (see BOOT_PROFILE).
#
# Architecture-specific package selection:
#   x86_64 (amd64):  linux-image-${KERNEL_VARIANT}-amd64, grub-efi-amd64-signed (+ signed hold)
#   arm64   (arm64): linux-image-${KERNEL_VARIANT}-arm64, u-boot-tools, firmware-linux-free,
#                    firmware-misc-nonfree
#
# Both architectures share:
#   - Containerfile.base (debian:trixie, no -slim variant published for trixie as of 2025)
#   - bootc / dracut / ostree stack (from the bootc APT repo)
#   - systemd-networkd (shipped by systemd, not a separate package on Trixie)
#   - systemd-timesyncd (repacked with network-online drop-in from bootc repo)
#   - journald Storage=none (no persistent logging)
#   - aggressive service masking (cron, getty tty2-6, apt-daily, rsyslog, etc.)
#   - kernel cmdline: quiet init_on_alloc=0 (arm64 adds serial consoles)
#
# Custom kernel (optional):
#   ARG KERNEL_VARIANT selects the kernel package via the
#   `linux-image-${KERNEL_VARIANT}-${ARCH}` naming pattern. `minimal` (default)
#   installs `linux-image-minimal-${ARCH}`, the custom kernel built from the
#   fragments in kernel/config by the bootc-debs-builder pipeline.
#   The custom kernel .deb is published as `daemoncores-kernel-<kver>` (file
#   `linux-image-common_*.deb`) and carries
#   `Provides: linux-image-minimal-${ARCH}`, so the apt install resolves to it
#   through the virtual package mechanism. It Conflicts with and Replaces the
#   Debian `linux-image-<kver>` it overlaps, like the ostree package does with
#   libostree. Until the kernel build publishes its first .deb, the install
#   fails (the package is absent from every repo) — this is expected.
#   See docs/minimal.md ("Kernel and auto-update").
#
# Per-arch kernel modules (optional):
#   The image installs ALL modules matching the target arch in a separate
#   conditional RUN block below (after the main apt install): x86_64 needs none
#   (its overlay is part of the kernel); arm64 -> the linux-modules-<device>
#   packages of ARM_DEVICES (rpi3/rpi4 on the 4 KB kernel, rpi5/rk3588 on the
#   16 KB one) so a single arm64 image boots on every SBC the project targets.
#   The modules are optional — the kernel (linux-image-common) works
#   without them.
#
# Auto-update:
#   One image per tag. The bootc package enables bootc-fetch-apply-updates.timer;
#   opting out is a run-time choice, a symlink to /dev/null in /etc (see
#   docs/minimal.md, "Kernel and auto-update").
#
# Trade-offs (documented in docs/minimal.md):
#   - No man pages, no nano, no bash-completion
#   - No logging persistence (journald volatile only)
#   - No getty on tty2-6 (single tty1 console)
#
# This file intentionally does NOT touch the original Containerfile.
# #####################################################################################

ARG BASE_IMAGE=localhost/debian-bootc-base
FROM ${BASE_IMAGE}
# The shell is inherited from the base; repeated so the linter and the reader see it.
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

LABEL org.opencontainers.image.title="Debian Trixie bootc minimal (multi-arch)"
LABEL org.opencontainers.image.description="Ultra-minimal Debian 13 Trixie bootc/ostree image for x86_64 and ARM64. Research target: ~50 MB RAM idle."
# Asks the CI for two arm64 kernels (docs/decisions.md, "Two arm64 kernels"): the
# plain tag is built on the 16 KB kernel, and a second arm64-only image tagged
# `<tag>-4k` carries the 4 KB kernel for Raspberry Pi 3 and 4.
LABEL org.daemoncores.arm64-4k-image="true"
# Asks the CI (both signing mode) for the unsigned-kernel twin of this image,
# tagged `<tag>-nosign`: the same image on the -nosign kernel package, for amd64
# and the plain-tag arm64 kernel only. The 4 KB image has no twin.
LABEL org.daemoncores.unsigned-kernel-image="true"

# Standing on Containerfile.base (SSL prerequisites, trusted bootc APT repository), so
# the build starts at the package set. The CI builds the base once per job and passes
# it as BASE_IMAGE; it never pushes it.
# -----------------------------------------------------------------------------
# Phase 3: Install the ultra-minimal package set, kernel excluded
# -----------------------------------------------------------------------------
# The kernel is installed by the next RUN, so the signed image and its `-nosign` twin
# share every layer up to here. BOOT_PKG and FIRMWARE_PKGS stay separate ARGs because
# arm64 does NOT follow the grub-efi-${ARCH} pattern (u-boot-tools) and firmware is
# empty on x86_64. wget, kept by the base for its key download, is purged here: the
# minimal image does not carry it.
# Target architecture: amd64 (x86_64) default; CI overrides to arm64 via --build-arg ARCH=arm64.
ARG ARCH=amd64
# Boot profile, set by the CI from `LABEL org.daemoncores.boot-profile` (generic when
# absent): `generic` boots through UEFI with the Fedora GRUB (amd64, and arm64 PCs,
# servers, VMs); `embedded` is arm64 boards whose firmware loads U-Boot.
ARG BOOT_PROFILE=generic
# Boot stack chosen by the CI from the architecture and the boot profile:
# grub-efi-amd64-signed (amd64), grub-efi-arm64-signed (arm64 generic) or
# u-boot-tools (arm64 embedded). A separate ARG because arm64 does NOT follow the
# grub-efi-${ARCH} pattern in the embedded profile.
ARG BOOT_PKG=grub-efi-amd64-signed
# Firmware packages: empty on x86_64 (downstream adds microcode); arm64 ships
# firmware-linux-free firmware-misc-nonfree for SBC peripherals.
ARG FIRMWARE_PKGS=""
RUN for _r in 1 2 3 4 5; do \
        rm -rf /var/lib/apt/lists/* && apt update && break; \
        [ "$_r" -lt 5 ] && sleep 30; \
    done \
    && apt install -y --no-install-recommends \
        bootc \
        bootupd \
        podman \
        skopeo \
        openssh-server \
        dracut \
        ${BOOT_PKG} \
        ${FIRMWARE_PKGS} \
        btrfs-progs \
        iproute2 \
        systemd-timesyncd \
        ca-certificates \
    && apt-get purge -y --autoremove wget \
    && rm -rf \
        /tmp/* \
        /var/tmp/* \
        /run/* \
        /usr/sbin/policy-rc.d

# -----------------------------------------------------------------------------
# Phase 3.1: Kernel and its device modules
# -----------------------------------------------------------------------------
# The only layer that differs between the signed image and its `-nosign` twin. The
# kernel package is derived from KERNEL_VARIANT, KERNEL_SUFFIX and ARCH via the
# linux-image-${KERNEL_VARIANT}${KERNEL_SUFFIX}-${ARCH} naming pattern, so there is no
# if/else. The custom kernel .deb (daemoncores-kernel-<kver>, built by the
# bootc-debs-builder pipeline) is repacked with `Provides: linux-image-minimal-${ARCH}`
# so apt resolves the virtual name once the kernel build publishes. Until the first
# kernel build succeeds, the package is absent from every repo and the install fails;
# see docs/minimal.md ("Kernel and auto-update").
ARG KERNEL_VARIANT=minimal
# arm64 only. The arm64 distribution ships two kernels because the page size is a
# compile-time choice (docs/decisions.md, "Two arm64 kernels"): the 4 KB kernel
# (KERNEL_SUFFIX empty) for Raspberry Pi 3 and 4, the 16 KB kernel (KERNEL_SUFFIX
# `-16k`) for recent hardware. ARM_DEVICES lists the device module packages that
# kernel serves (rpi3/rpi4 on the 4 KB kernel, rpi5/rk3588 on the 16 KB one); they
# are optional, the kernel works without them. The CI passes the values per image;
# the defaults build the 4 KB one.
ARG ARM_DEVICES="rpi3 rpi4"
ARG KERNEL_SUFFIX=""
# The apt lists are wiped after every dpkg run (src/debianpreinstall/etc/apt/apt.conf.d/99-apt-clean),
# so this layer refreshes them itself, then installs the kernel and the device modules in one
# transaction.
RUN for _r in 1 2 3 4 5; do \
        apt update && break; \
        [ "$_r" -lt 5 ] && sleep 30; \
    done \
    && set -- \
    && if [ "${ARCH}" = "arm64" ]; then \
        for _d in ${ARM_DEVICES}; do set -- "$@" "linux-modules-${_d}"; done; \
    fi \
    && apt install -y --no-install-recommends \
        linux-image-${KERNEL_VARIANT}${KERNEL_SUFFIX}-${ARCH} "$@"

# -----------------------------------------------------------------------------
# Phase 4: GRUB kernel command line (arch-conditional)
# -----------------------------------------------------------------------------
# quiet: suppress kernel boot messages. init_on_alloc=0: disable default-on page
# zeroing hardening (unjustified on a no-untrusted-workload minimal image; saves
# ~1-3% allocation overhead). Written to /etc/default/grub so bootc-finalize picks
# it up when regenerating BLS entries.
# arm64 adds serial consoles (ttyAMA0, ttyS0, ttyAML0) covering common ARM64 SBC
# UARTs; the kernel silently ignores non-existent consoles, so all three are safe.
# Fixes A5 (ttyAMA0 alone is not universal on arm64).
# Idempotent upsert without a conditional: touch guarantees the file exists (u-boot
# on arm64 ships no /etc/default/grub), sed -i /d removes any prior directive line,
# printf >> appends the fresh value. Fixes A3 (no duplication on rebuild).
# Extra kernel cmdline for serial consoles: empty on x86_64; arm64 adds
# console=ttyAMA0,115200 console=ttyS0,115200 console=ttyAML0,115200.
ARG KERNEL_CMDLINE_SERIAL=""
COPY ./src/minimalpostinstall /
RUN sed -i '/^GRUB_CMDLINE_LINUX_DEFAULT=/d' /etc/default/grub || true \
    && printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet init_on_alloc=0%s%s"\n' \
        "${KERNEL_CMDLINE_SERIAL:+ }" "${KERNEL_CMDLINE_SERIAL}" \
        >> /etc/default/grub \
    && systemctl enable systemd-networkd.service \
    && systemctl enable systemd-networkd.socket \
    && systemctl enable systemd-timesyncd.service \
    && systemctl enable ssh-host-keygen.service \
    && systemctl mask -- \
        cron.service \
        getty@tty2.service \
        getty@tty3.service \
        getty@tty4.service \
        getty@tty5.service \
        getty@tty6.service \
        apt-daily.timer \
        apt-daily-upgrade.timer \
        apt-daily.service \
        apt-daily-upgrade.service \
        rsyslog.service \
        man-db.timer \
        man-db.service \
        console-setup.service \
        keyboard-setup.service \
        e2scrub_all.timer \
        e2scrub_all.service \
        fstrim.timer \
        fstrim.service \
        logrotate.timer \
        logrotate.service

# -----------------------------------------------------------------------------
# Phase 5: ostree filesystem migration
# -----------------------------------------------------------------------------
# bootc/ostree requires /home, /root, /mnt, /srv, /opt as symlinks into /var so the
# read-only /usr tree can be swapped atomically while mutable state persists in /var.
# Shared with the main Containerfile through src/ostreelayout.
COPY ./src/ostreelayout /
RUN /usr/libexec/debian-bootc/ostree-layout \
    && rm -f /etc/ssh/ssh_host_*

# Host-side signature enforcement. The pipeline passes the repository's cosign
# public key and the image reference; both are empty until the key exists, in
# which case no policy is shipped (see src/signaturepolicy).
ARG IMAGE_REF=""
ARG COSIGN_PUBKEY_B64=""
COPY ./src/signaturepolicy /
RUN /usr/libexec/debian-bootc/install-signature-policy "${IMAGE_REF}" "${COSIGN_PUBKEY_B64}"

# -----------------------------------------------------------------------------
# Phase 6: Healthcheck
# -----------------------------------------------------------------------------
# bootc images are updated in-place via ostree; a healthcheck would spawn a
# process on a schedule, defeating the minimal RAM target.
HEALTHCHECK NONE