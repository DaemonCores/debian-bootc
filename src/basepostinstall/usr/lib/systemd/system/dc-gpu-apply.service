[Unit]
Description=Apply the stored GPU userspace profile (dc-gpu)
Documentation=man:ld.so(8)
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target systemd-modules-load.service
ConditionPathExists=/usr/sbin/dc-gpu

[Service]
Type=oneshot
ExecStart=/usr/sbin/dc-gpu apply
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
