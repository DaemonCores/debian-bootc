#!/bin/sh
# Convert the image filesystem layout to what bootc/ostree requires.
#
# /home, /root, /mnt, /srv and /opt must be symlinks into /var so the read-only
# /usr tree can be swapped atomically while mutable state persists in /var.
# Do NOT change the layout or bootc fails.
set -eu

mkdir -p /var/home \
  /var/roothome \
  /var/mnt \
  /var/srv \
  /var/opt \
  /var/usr/lib/locale \
  /sysroot/ostree

# Locales generated at build time move to /var; a missing directory is fine.
cp -r /usr/lib/locale/* /var/usr/lib/locale/ || true

# Removing /home, /root, /mnt, /srv and /opt is the point: they become symlinks.
# shellcheck disable=SC2114
rm -rf /home \
  /root \
  /mnt \
  /srv \
  /opt \
  /usr/lib/locale \
  /tmp/* \
  /var/tmp/* \
  /run/* \
  /usr/sbin/policy-rc.d

ln -s var/home /
ln -s var/mnt /
ln -s var/srv /
ln -s var/opt /
ln -s var/roothome /root
ln -s sysroot/ostree /ostree
ln -s var/usr/lib/locale /usr/lib/locale
