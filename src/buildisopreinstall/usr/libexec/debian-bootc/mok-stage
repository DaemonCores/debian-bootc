#!/bin/bash
#
# Queue the DaemonCores Secure Boot certificate and every public certificate
# dropped in MOK_DIR for MOK enrollment, in ONE request (one password).
#
# Runs as root (through pkexec) from the live installer session once the
# install succeeded. The one-time MokManager password is read from stdin so it
# never appears in a process list or a log.

set -euo pipefail

readonly CERT=/usr/share/debian-bootc/sb_signing.crt
# Public certificates (PEM or DER) of forks and extra layers; read at install
# time, so adding one needs no rebuild. Never put a private key here.
readonly MOK_DIR=/usr/share/debian-bootc/mok.d

#######################################
# Print an error message on stderr.
# Globals:
#   None
# Arguments:
#   Message words.
# Outputs:
#   Writes the message to stderr.
#######################################
err() {
  echo "mok-stage: $*" >&2
}

#######################################
# List the certificates to enroll that are not yet trusted.
# Globals:
#   CERT
#   MOK_DIR
# Outputs:
#   Writes one path per line on stdout; skips files holding a private key.
#######################################
pending_certs() {
  local cert
  for cert in "${CERT}" "${MOK_DIR}"/*.crt "${MOK_DIR}"/*.cer \
    "${MOK_DIR}"/*.pem "${MOK_DIR}"/*.der; do
    [[ -f "${cert}" ]] || continue
    if grep -q 'PRIVATE KEY' "${cert}" 2>/dev/null; then
      err "refusing ${cert}: contains a private key"
      continue
    fi
    if mokutil --test-key "${cert}" >/dev/null 2>&1; then
      err "${cert} already enrolled"
      continue
    fi
    printf '%s\n' "${cert}"
  done
}

#######################################
# Stage the certificates for the next MokManager run.
# Globals:
#   CERT
#   MOK_DIR
# Arguments:
#   None
# Outputs:
#   Writes diagnostics to stderr; never the password.
# Returns:
#   0 when staged, 2 when nothing needs staging (no UEFI, no mokutil,
#   no certificate, all already enrolled), 1 on failure.
#######################################
main() {
  local password
  local -a certs

  if [[ ! -d /sys/firmware/efi ]]; then
    err "no UEFI firmware, nothing to enroll"
    return 2
  fi
  if ! command -v mokutil >/dev/null 2>&1 \
    || ! command -v openssl >/dev/null 2>&1; then
    err "mokutil or openssl not available"
    return 2
  fi
  mapfile -t certs < <(pending_certs)
  if [[ ${#certs[@]} -eq 0 ]]; then
    err "no certificate to enroll"
    return 2
  fi

  IFS= read -r password || [[ -n "${password}" ]]
  if [[ ${#password} -lt 8 ]]; then
    err "password too short"
    return 1
  fi

  # mokutil --import would prompt on the terminal; a crypt(3) hash file keeps
  # the clear text password off the command line and out of any prompt.
  local hash_file
  hash_file="$(mktemp)"
  # Expand now on purpose: hash_file is local and out of scope when EXIT fires.
  # shellcheck disable=SC2064
  trap "rm -f '${hash_file}'" EXIT
  chmod 600 "${hash_file}"
  printf '%s' "${password}" | openssl passwd -6 -stdin >"${hash_file}" \
    || {
      err "could not hash the password"
      return 1
    }
  mokutil --import "${certs[@]}" --hash-file "${hash_file}" \
    || {
      err "mokutil --import failed"
      return 1
    }
}

main "$@"
