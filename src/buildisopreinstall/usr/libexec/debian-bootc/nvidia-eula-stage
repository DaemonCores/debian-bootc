#!/usr/bin/env python3
"""nvidia-eula-stage — GPU detection, NVIDIA EULA consent and image gate.

Installer-lane helper (wiki: GPU-Support.md, install-time EULA flow).

Commands:

    probe                       exit 0 and print the lspci device lines when
                                an NVIDIA GPU is detected, exit 1 otherwise
    text                        print the shipped EULA text verbatim
    consent [--accept]          display the EULA, record the explicit
                                acceptance flag only on a strict ``ACCEPT``
                                (or ``--accept`` for scripted runs)
    usage <gaming|ia|auto>      record the chosen GPU usage profile for the
                                install step (consumed by ``dc-gpu``); it
                                never requires the acceptance flag
    image <imgref>              gate the image chosen for the install: exit 1
                                when its entry in the installer recipe carries
                                an ``eula`` field and the acceptance flag is
                                not recorded; any other image passes

The license is tied to the image that ships the NVIDIA proprietary stack (its
recipe entry carries the ``eula`` field), not to the hardware or to the usage
profile: the standard image never needs it.
"""

import json
import os
import subprocess
import sys
from pathlib import Path
from typing import NoReturn, cast

EULA_TXT = Path(
    os.environ.get(
        "NVIDIA_EULA_FILE", "/usr/share/debian-bootc/nvidia-eula.txt"
    )
)
STATE_DIR = Path(
    os.environ.get("NVIDIA_EULA_STATE_DIR", "/run/bootc-installer")
)
RECIPE_FILE = Path(
    os.environ.get("INSTALLER_RECIPE_FILE", "/etc/bootc-installer/recipe.json")
)
STATE_FILE = STATE_DIR / "nvidia-eula-accepted"
USAGE_FILE = STATE_DIR / "gpu-usage"
USAGES = ("gaming", "ia", "auto")
ACCEPT_WORD = "ACCEPT"


def fail(message: str) -> NoReturn:
    """Print an error on stderr and exit with status 1.

    Args:
        message: The error text to report.
    """
    print(f"nvidia-eula-stage: {message}", file=sys.stderr)
    sys.exit(1)


def probe() -> int:
    """Detect an NVIDIA GPU with lspci.

    Returns:
        0 when at least one NVIDIA display/3D controller exists, 1 otherwise.
    """
    devices = nvidia_devices()
    for line in devices:
        print(line)
    return 0 if devices else 1


def nvidia_devices() -> list[str]:
    """List the NVIDIA display/3D devices lspci sees.

    Returns:
        The lspci device lines (empty when lspci is missing or no device).
    """
    return [
        line for cmdline in (
            ["lspci", "-d", "10de::0300"],
            ["lspci", "-d", "10de::0380"],
        ) for line in run_lspci(cmdline).splitlines() if line.strip()
    ]


def run_lspci(args: list[str]) -> str:
    """Run lspci with the given arguments.

    Args:
        args: Command line after ``lspci``.

    Returns:
        Stdout of lspci, empty when lspci is missing or fails.
    """
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        return ""
    return result.stdout if result.returncode == 0 else ""


def eula_text(path: str = str(EULA_TXT)) -> str:
    """Read the shipped EULA text.

    Args:
        path: Path of the EULA text file.

    Returns:
        The file content verbatim.
    """
    return Path(path).read_text(encoding="utf-8")


def cmd_text() -> int:
    """Print the EULA text verbatim.

    Returns:
        0 on success, 1 when the text is missing.
    """
    try:
        sys.stdout.write(eula_text())
    except OSError as err:
        fail(f"EULA text missing: {err}")
    return 0


def cmd_consent(accept: bool) -> int:
    """Record the explicit EULA acceptance in the state file.

    Args:
        accept: When True, record non-interactively; otherwise require the
            exact ``ACCEPT`` word on stdin.

    Returns:
        0 when accepted, 1 otherwise.
    """
    if not accept:
        try:
            sys.stdout.write(eula_text())
        except OSError as err:
            fail(f"EULA text missing: {err}")
        sys.stdout.write("\nType ACCEPT exactly (nothing else will do): ")
        sys.stdout.flush()
        if sys.stdin.readline().rstrip("\n") != ACCEPT_WORD:
            print(
                "nvidia-eula-stage: EULA not accepted; "
                "NVIDIA userspace stays inactive.",
                file=sys.stderr,
            )
            return 1
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text("accepted-at-install\n", encoding="utf-8")
    return 0


def cmd_usage(usage: str) -> int:
    """Validate a GPU usage profile and record it for the install step.

    Args:
        usage: One of ``gaming``, ``ia``, ``auto``.

    Returns:
        0 on success, 1 when the profile is unknown.
    """
    if usage not in USAGES:
        fail(f"{usage}: unknown usage, expected one of {', '.join(USAGES)}")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    USAGE_FILE.write_text(f"{usage}\n", encoding="utf-8")
    return 0


def image_requires_eula(imgref: str) -> bool:
    """Tell whether the recipe entry of an image demands the license.

    Args:
        imgref: Image reference chosen for the install.

    Returns:
        True when an entry of the installer recipe has this ``imgref`` and an
        ``eula`` field; False for any other image, including one the recipe
        does not list.
    """
    try:
        recipe = cast(
            object, json.loads(RECIPE_FILE.read_text(encoding="utf-8"))
        )
    except (OSError, ValueError) as err:
        fail(f"installer recipe unreadable: {err}")
    if not isinstance(recipe, dict):
        return False
    images = cast(dict[str, object], recipe).get("images", [])
    if not isinstance(images, list):
        return False
    for entry in cast(list[object], images):
        if not isinstance(entry, dict):
            continue
        fields = cast(dict[str, object], entry)
        if fields.get("imgref") == imgref and fields.get("eula"):
            return True
    return False


def cmd_image(imgref: str) -> int:
    """Gate an image on the recorded license acceptance.

    Args:
        imgref: Image reference chosen for the install.

    Returns:
        0 when the image needs no license or it was accepted, 1 otherwise.
    """
    if image_requires_eula(imgref) and not STATE_FILE.is_file():
        fail(f"{imgref}: the license of this image was not accepted")
    return 0


def main() -> NoReturn:
    """Entry point: dispatch the command line."""
    args: list[str] = sys.argv[1:]
    if not args:
        print((__doc__ or __package__ or "usage").strip(), file=sys.stderr)
        sys.exit(1)
    command, rest = args[0], args[1:]
    if command == "probe":
        sys.exit(probe())
    if command == "text":
        sys.exit(cmd_text())
    if command == "consent":
        sys.exit(cmd_consent("--accept" in rest))
    if command == "usage" and len(rest) == 1:
        sys.exit(cmd_usage(rest[0]))
    if command == "image" and len(rest) == 1:
        sys.exit(cmd_image(rest[0]))
    fail(
        "usage: nvidia-eula-stage {probe|text|consent [--accept]|"
        "usage <gaming|ia|auto>|image <imgref>}"
    )


if __name__ == "__main__":
    main()
