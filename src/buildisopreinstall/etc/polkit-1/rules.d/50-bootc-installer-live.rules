polkit.addRule(function(action, subject) {
    if (action.id === "org.tunaos.Installer" &&
        subject.user === "live") {
        return polkit.Result.YES;
    }
});

// The installer queues the Secure Boot certificate for MOK enrollment once
// the install succeeded; only that helper is allowed without a prompt.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") ===
            "/usr/libexec/debian-bootc/mok-stage" &&
        subject.user === "live") {
        return polkit.Result.YES;
    }
});
// The installer stage gates the -nvidia image behind GPU detection and the
// NVIDIA EULA acceptance recorded at install (wiki: GPU-Support.md).
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") ===
            "/usr/libexec/debian-bootc/nvidia-eula-stage" &&
        subject.user === "live") {
        return polkit.Result.YES;
    }
});
// The GPU module set selector, called by the installer GPU step right after
// the usage choice (gpu_config.stage_choice); without this rule the step
// fails with "The choice could not be recorded" in the agent-less session.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") ===
            "/usr/libexec/debian-bootc/gpu-set-stage.py" &&
        subject.user === "live") {
        return polkit.Result.YES;
    }
});
