"""Minimal typed GTK surface used by the installer overlay.

Only the members the overlay calls are declared, with concrete types: the
overlay must stay checkable under basedpyright strict without falling back to
Any.
"""

from collections.abc import Callable, Sequence
from typing import TypeVar

_T = TypeVar("_T")


class Widget:
    """Base of the widgets the overlay template children are bound to."""

    def __init__(self, **kwargs: object) -> None: ...
    def connect(self, signal: str, handler: Callable[..., object]) -> int: ...
    def emit(self, signal: str) -> None: ...
    def set_visible(self, visible: bool) -> None: ...
    def set_sensitive(self, sensitive: bool) -> None: ...
    def set_model(self, model: object) -> None: ...
    def get_text(self) -> str: ...
    def set_text(self, text: str) -> None: ...
    def get_active(self) -> bool: ...
    def get_selected(self) -> int: ...
    def add_css_class(self, name: str) -> None: ...
    def remove_css_class(self, name: str) -> None: ...


class StringList(Widget):
    """List model of strings."""

    @classmethod
    def new(cls, strings: Sequence[str]) -> "StringList": ...


class _Template:
    """The Gtk.Template decorator and its child accessor."""

    def __call__(
        self, *, resource_path: str
    ) -> Callable[[type[_T]], type[_T]]: ...
    def Child(self) -> Widget: ...


Template: _Template
