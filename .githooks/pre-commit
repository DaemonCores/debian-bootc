#!/bin/bash
# Local pre-commit: the exact gate CI runs (.github/workflows/lint.yml), through
# the Makefile so the venv bootstrap (.ci fetch included) is shared with CI.
set -euo pipefail

if ! make -C "$(git rev-parse --show-toplevel)" admission check docs-check; then
  echo "" >&2
  echo "pre-commit: lint gate failed (admission check docs-check) - fix the errors above." >&2
  echo "Escalate with 'git commit --no-verify' if really needed (CI will still fail)." >&2
  exit 1
fi
