# modules-kernel/rpi4
#
# Per-device MODULE overlay for the Raspberry Pi 4 (BCM2711). Applied on top
# of the base kernel/config THEN the ARM-generic overlay modules-kernel/arm:
#     scripts/kconfig/merge_config.sh -m .config kernel/config modules-kernel/arm modules-kernel/rpi4
#     make olddefconfig
#
# This file is NOT a full .config. It lists ONLY options that are specific
# to the Raspberry Pi 4 — everything shared across all devices (filesystems,
# virtio, serial console, the disabled subsystems) lives in kernel/config, and
# everything shared across all ARM devices (ARM64, CMDLINE, PL011, MMC/USB/RTC
# subsystem cores) lives in modules-kernel/arm. Neither is repeated here. The
# modules built from this overlay are OPTIONAL; the base image
# (linux-image-common) works without them.
#
# Device: Raspberry Pi 4 / 4B (Broadcom BCM2711, ARM Cortex-A72).
#
# Conventions:
#   # reason in English
#   CONFIG_OPTION=y           # built-in
#   CONFIG_OPTION=m           # module
#   # CONFIG_OPTION is not set  # disabled

# =============================================================================
# SoC platform support — built-in. The kernel must know about the SoC before
# it can parse the device tree, so this is built-in rather than a module.
# =============================================================================

# BCM2711: Raspberry Pi 4 SoC. Built-in.
CONFIG_ARCH_BCM2711=y

# =============================================================================
# MMC / SD / eMMC — built-in. The Pi boots from the SD card; the kernel must
# be able to read it without a module load step. The SDHCI core + platform
# glue + USB host controllers are shared across all ARM devices and live in
# modules-kernel/arm; this overlay keeps ONLY the Broadcom-specific SDHCI
# controller (sdhost).
# =============================================================================

# Broadcom SDHCI: built-in. Raspberry Pi 4 uses a custom SDHCI controller
#                 (sdhost) for the SD card. Required to boot from the SD card.
#                 (CONFIG_MMC_SDHCI + CONFIG_MMC_SDHCI_PLTFM are in
#                 modules-kernel/arm.)
CONFIG_MMC_BCM2835=y

# =============================================================================
# Ethernet — built-in. Network must come up at boot so bootc can fetch the
# next deployment.
# =============================================================================

# BCMGENET: built-in. Broadcom GENET Ethernet controller, used on the
#           Raspberry Pi 4 (the wired Ethernet port).
CONFIG_BCMGENET=y